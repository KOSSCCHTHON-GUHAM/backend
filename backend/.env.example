# Server
PORT=3000
NODE_ENV=development

# OpenAI / AI API Configuration
OPENAI_BASE_URL=https://ai.cs.kookmin.ac.kr/v1
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_EMBEDDING_MODEL=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 백엔드 전용 관리자 키입니다. 프론트에 노출 금지.
SUPABASE_SECRET_KEY=

# REST API와 Socket.IO 허용 Origin. Expo Web은 보통 8081을 사용합니다.
# 여러 개면 쉼표로 구분하고, 실제 휴대폰 앱 요청은 브라우저 CORS 대상이 아닙니다.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:8081
